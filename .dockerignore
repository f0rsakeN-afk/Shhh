# Secrets must never enter the build context. `.env.example` is safe and is
# copied so the image documents its own configuration surface.
.env
.env.*
!.env.example

# Installed and generated locally; the image builds its own copies.
node_modules
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Repository metadata and local tooling.
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Tests, docs and container files are not needed by the build.
tests
coverage
README.md
CHANGELOG.md
LICENSE
AGENTS.md
Dockerfile
Dockerfile.dev
.dockerignore
docker-compose.yml
docker-compose.dev.yml
