# Development image for Shhh.
#
# The source tree is bind-mounted by docker-compose.dev.yml; this image only
# provides the toolchain. Dependencies live in a named volume so container
# binaries never overwrite (or get overwritten by) the host's `node_modules`.
# syntax=docker/dockerfile:1

FROM oven/bun:1-slim AS dev
WORKDIR /app

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    HOME=/tmp

COPY package.json bun.lock ./
# The cache mount keeps repeat builds fast without baking it into a layer.
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile \
  && touch node_modules/.shhh-install-stamp

COPY . .

# Everything under /app is owned by the runtime user, so the bind mount and
# the node_modules volume are writable by the host user (UID 1000 by default).
# `.next` must exist here too: an empty named volume otherwise gets a
# root-owned mount point, and `next dev` cannot create its build directory.
RUN mkdir -p /app/.next && chown -R bun:bun /app

COPY --chmod=0755 scripts/dev-entrypoint.sh /usr/local/bin/shhh-dev-entrypoint

USER bun
EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/shhh-dev-entrypoint"]
