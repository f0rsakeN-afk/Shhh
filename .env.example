# Upstash Redis (required for rooms, presence, and realtime)
# Create a database at https://console.upstash.com and copy both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL used for canonical links, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL used by the API client. Defaults to the current origin locally.
NEXT_PUBLIC_API_URL=http://localhost:3000
